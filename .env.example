# ============================================
# Outline Configuration - Windows Docker Setup
# ============================================
# Copy this file to .env and fill in your values
# Never commit the .env file (it contains secrets)

# ----- Step 1: Generate Secrets -----
# Run this command TWICE in PowerShell to generate two random secrets:
# docker run --rm alpine sh -c "apk add --no-cache openssl >/dev/null && openssl rand -hex 32"
SECRET_KEY=PASTE_FIRST_RANDOM_HEX_HERE
UTILS_SECRET=PASTE_SECOND_RANDOM_HEX_HERE

# ----- Step 2: Database Password -----
# Choose a strong password for PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ----- Step 3: Outline URL -----
# Replace with your actual Windows machine IP address
# Find it with: ipconfig (look for IPv4 Address)
# Example: http://192.168.1.100:6875
OUTLINE_URL=http://YOUR_IP_ADDRESS:6875

# ----- Step 4: OIDC Configuration -----
# Get these values from your Identity Provider (Keycloak/Auth0/Authentik/etc.)
# IMPORTANT: Set redirect URI in your IdP to: http://YOUR_IP_ADDRESS:6875/auth/oidc.callback

OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_AUTH_URI=https://your-idp.com/auth/realms/master/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://your-idp.com/auth/realms/master/protocol/openid-connect/token
OIDC_USERINFO_URI=https://your-idp.com/auth/realms/master/protocol/openid-connect/userinfo

# ----- Optional: Google OAuth (for later when using HTTPS) -----
# Only works with https:// URLs or http://localhost (not http://IP)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ----- Optional: SMTP Email Configuration -----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=Outline Wiki <noreply@yourcompany.com>
